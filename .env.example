# =
#  Jawla SERVER SECRETS — paste your keys here yourself.
#  This file is git-ignored and is NEVER loaded by the app.
#  Do not paste these values into the chat.
# =

# --- MyFatoorah (payments, M6) -----------------------------
# Sandbox: https://apitest.myfatoorah.com  (live later: https://api.myfatoorah.com)
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_TOKEN=
# Webhook secret key from MyFatoorah > Integration Settings > Webhook
MYFATOORAH_WEBHOOK_SECRET=

# --- Twilio (phone sign-in codes, M4) ----------------------
# These go into Supabase Dashboard > Authentication > Sign In / Providers > Phone,
# not into edge functions. Keep a copy here for your records.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=

# --- Sentry (M8) -------------------------------------------
SENTRY_AUTH_TOKEN=

# --- Supabase secret key (only if ever needed by a script) -
# Starts with sb_secret_ . Skips every rule. Never in the app, never on GitHub.
SUPABASE_SECRET_KEY=
